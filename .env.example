# ── PostgreSQL ──
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio

# ── Production (uncomment for deployment) ──
# POSTGRES_PASSWORD=change_this_password
# DATABASE_URL=postgres://portfolio:change_this_password@db:5432/portfolio
# JWT_SECRET=change_this_jwt_secret_key
# ADMIN_PASSWORD=change_this_admin_password

# ── Development (uncomment for local dev) ──
POSTGRES_PASSWORD=portfolio
DATABASE_URL=postgres://portfolio:portfolio@db:5432/portfolio
JWT_SECRET=dev-secret-key-change-in-production
ADMIN_PASSWORD=admin123

# ── Shared ──
ADMIN_USERNAME=admin

# ── Cloudflare Turnstile ──
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=   (frontend — public)
# TURNSTILE_SECRET_KEY=            (backend — secret)

# ── Frontend ──
NEXT_PUBLIC_API_URL=https://thalvindo.my.id
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_APP_ENV=production

# REMINDER: Generate secrets before deploying to production:
#   openssl rand -base64 24 | tr -dc 'a-zA-Z0-9'   (POSTGRES_PASSWORD)
#   openssl rand -base64 32 | tr -dc 'a-zA-Z0-9'   (JWT_SECRET)
#   openssl rand -base64 12 | tr -dc 'a-zA-Z0-9'   (ADMIN_PASSWORD)
